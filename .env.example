# MongoDB connection string (Atlas SRV URI or self-hosted)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Long random string used to encrypt/sign session & flash cookies.
# Generate one with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string

# Port the server listens on (Koyeb sets this automatically at runtime)
PORT=8000
