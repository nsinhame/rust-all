# MongoDB connection string (Atlas SRV URI or self-hosted)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Shared secret required to reach the app at all, e.g.
# https://your-host/link-review?key=replace-with-a-long-random-string
# Also used to encrypt/sign session & flash cookies.
# Generate one with: openssl rand -hex 32
ACCESS_KEY=replace-with-a-long-random-string

# Reviewer login accounts (username/password login, on top of the ACCESS_KEY gate above).
# Numbered starting at 1 with no gaps; add as many pairs as you need (USER2, USER3, ...).
LINK_REVIEW_USER1=nik
LINK_REVIEW_USER1_PASS=replace-with-a-real-password
LINK_REVIEW_USER2=prdp
LINK_REVIEW_USER2_PASS=replace-with-a-real-password

# Port the server listens on (Koyeb sets this automatically at runtime)
PORT=8000

# Base domain used to build each file's DL/Watch links (no scheme, no trailing slash).
# Links are built as https://$FQDN/dl/<id>/<name> and https://$FQDN/watch/<id>/<name>.
# Update this whenever the CDN host changes instead of redeploying code.
FQDN=fcdn.example.com
